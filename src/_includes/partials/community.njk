<section class="community" aria-labelledby="community-heading">
  <div class="wrap community-wrap">
    <div>
      <h2 id="community-heading">Join our Community of Practice</h2>
      <p>For leaders who want to simplify work, lift capability, and build cultures where people thrive.</p>
      <p class="community-note">We handle your details in line with our <a href="/privacy-policy">Privacy Policy</a>.</p>
    </div>
    <form class="community-form" id="community-form" name="community-signup" method="POST" data-netlify="true" netlify-honeypot="cp-bot-field">
      <input type="hidden" name="form-name" value="community-signup">
      <p style="display:none">
        <label>Leave this field blank: <input name="cp-bot-field"></label>
      </p>
      <label class="visually-hidden" for="community-email">Email address</label>
      <input id="community-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" required>
      <button type="submit" class="btn btn-primary btn-sm">Sign up</button>
    </form>
  </div>
</section>
