<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/img/logo-footer.png" alt="Simplify Co. logo" width="1195" height="269">
        <span class="footer-tag">{{ site.tagline }}</span>
      </div>
      <nav class="footer-links" aria-label="Footer">
        {%- for item in site.nav %}
        <a href="{{ item.url }}"{% if item.url == path %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>Copyright © 2026 Simplify Co. All Rights Reserved. <span aria-hidden="true">·</span> <a href="/privacy-policy"{% if path == "/privacy-policy" %} aria-current="page"{% endif %}>Privacy Policy</a></span>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</footer>
